# Local dev (SQLite, zero setup)
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-dev-secret"
JWT_REFRESH_SECRET="change-me-dev-refresh-secret"
PORT=4000
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

